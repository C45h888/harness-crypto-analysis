# ===========================================================================
# crypto-ai-anal — environment configuration
# Copy to .env and fill in real values. .env is gitignored.
# ===========================================================================

# ---------------------------------------------------------------------------
# Postgres (canonical durable store). Compose builds DATABASE_URL per-service
# from these; the host-side DATABASE_URL below is for local CLI use only.
# ---------------------------------------------------------------------------
POSTGRES_DB=marketflow
POSTGRES_USER=marketflow
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://marketflow:change-me@127.0.0.1:5433/marketflow

# ---------------------------------------------------------------------------
# Redis (operational store). Compose builds REDIS_URL per-service; the host
# value below is for local CLI use.
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=marketflow
REDIS_STREAM_MAXLEN=10000

# ---------------------------------------------------------------------------
# Collector / orchestrator behavior
# ---------------------------------------------------------------------------
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
POLL_SECONDS=30
FLOW_WINDOW_SECONDS=300
DEPTH_LEVELS=20
MAX_DOMAIN_STATE_AGE_SECONDS=90
WALL_HISTORY_MAXLEN=200
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# External API credentials (data-access service ONLY).
# Leave blank for public-only Binance endpoints.
# ---------------------------------------------------------------------------
BINANCE_BASE_URL=
CRYPTOQUANT_API_KEY=
COINGECKO_BASE_URL=

# ---------------------------------------------------------------------------
# NOOA analyst model backend (harness / analyst service ONLY).
#
# The canonical naming scheme is NOOA_*. The analyst layer is read-only and
# receives only these model credentials — no exchange keys, no Docker socket.
#
# NOOA_MODEL_NAME is REQUIRED to run the analyst suite.
# NOOA_API_KEY is REQUIRED for any provider that needs authentication.
#
# Provider routing (backends.py):
#   openai    -> openai/<model>     (OpenAI-compatible gateways)
#   vllm      -> openai/<model>     (self-hosted OpenAI-compatible)
#   ollama    -> ollama/<model>     (local Apple Silicon)
#   anthropic -> anthropic/<model>  (Anthropic API or compatible gateway)
#   minimax   -> minimax/<model>    (litellm native minimax provider)
#   <other>   -> passthrough         (model name must carry its own prefix)
#
# For an OpenAI-compatible gateway (recommended — drops litellm entirely
# when the thin client is wired), set:
#   NOOA_MODEL_PROVIDER=openai
#   NOOA_MODEL_BASE_URL=https://your-gateway/v1
#   NOOA_API_KEY=your-key
#   NOOA_MODEL_NAME=your-model-id
# ---------------------------------------------------------------------------
NOOA_MODEL_PROVIDER=openai
NOOA_MODEL_NAME=
NOOA_API_KEY=
NOOA_MODEL_BASE_URL=
NOOA_MODEL_TEMPERATURE=0.2
NOOA_SESSION_ID=
# Per-agent LLM call budgets (seconds). The live envelope prompts are large;
# keep these above the endpoint's real latency.
NOOA_SPECIALIST_TIMEOUT_S=120
NOOA_CONTROLLER_TIMEOUT_S=180
