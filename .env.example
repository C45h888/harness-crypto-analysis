# ===========================================================================
# crypto-ai-anal — environment configuration
# Copy to .env and fill in real values. .env is gitignored.
# ===========================================================================

# ---------------------------------------------------------------------------
# Postgres (canonical durable store). Compose builds DATABASE_URL per-service
# from these; the host-side DATABASE_URL below is for local CLI use only.
# ---------------------------------------------------------------------------
POSTGRES_DB=marketflow
POSTGRES_USER=marketflow
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://marketflow:***@127.0.0.1:5433/marketflow

# ---------------------------------------------------------------------------
# Redis (canonical operational ledger). ALL market data lives here.
#
# The poller writes raw evidence to   marketflow:stream:raw:<SYM>
# The harness writes collated runs to  marketflow:latest:<SYM>:collated
# The harness writes analyst briefings to marketflow:agent:<SESSION>:briefings
# The harness writes agent memory to   marketflow:agent:<SESSION>:memory
#
# Multiple harness instances can read from the same Redis and share the
# full market data ledger. The harness never calls Binance directly —
# it reads from Redis and collates on its own schedule.
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=marketflow
REDIS_STREAM_MAXLEN=10000

# ---------------------------------------------------------------------------
# Poller behavior (raw-evidence firehose; cadence set by POLL_SECONDS)
# ---------------------------------------------------------------------------
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# POLL_SYMBOLS: subset of SYMBOLS the poller actively pulls. Empty = all of
# SYMBOLS. Override at runtime without restart: harness --poller-symbols SOLUSDT
# (Redis control key takes precedence over this env var; see --poller-status).
POLL_SYMBOLS=
POLL_SECONDS=30
FLOW_WINDOW_SECONDS=300
DEPTH_LEVELS=500
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Binance rate limiting (rate_limit/ substrate — one bounded worker per surface).
# The transport reads X-MBX-USED-WEIGHT-1M headers and enforces the ceiling
# BEFORE firing; 429 pauses the bucket, 418 seals it (fail-fast until unban).
# Set BINANCE_RATE_LIMIT_ENABLED=0 to restore legacy no-limit behavior.
# ---------------------------------------------------------------------------
BINANCE_RATE_LIMIT_ENABLED=1
# spot + futures main-pool 1-min weight budget
BINANCE_WEIGHT_LIMIT=6000
BINANCE_WEIGHT_CEILING=4800
# /futures/data/* tight pool
BINANCE_DATA_WEIGHT_LIMIT=3000
BINANCE_DATA_WEIGHT_CEILING=2400
# safety margin slept after a 418 ban expires
BINANCE_BAN_COOLDOWN_S=30

# ---------------------------------------------------------------------------
# External API credentials (poller service ONLY).
# Leave blank for public-only Binance endpoints.
# ---------------------------------------------------------------------------
BINANCE_BASE_URL=
CRYPTOQUANT_API_KEY=
COINGECKO_BASE_URL=

# ---------------------------------------------------------------------------
# NOOA analyst model backend (harness / analyst service ONLY).
#
# The canonical naming scheme is NOOA_*. The analyst layer is read-only and
# receives only these model credentials — no exchange keys, no Docker socket.
#
# NOOA_MODEL_NAME is REQUIRED to run the analyst suite.
# NOOA_API_KEY is REQUIRED for any provider that needs authentication.
#
# Provider routing: the transport is NOOA's unified-LLM client built on the
# LITELLM framework (upstream NOOA-native). Model routing is driven by the
# model string and the endpoint surface — change the model by editing the env
# layer here (no code changes):
#
# DESIGNATED CONFIG (2026-09-01): API-only via OpenRouter — no local compute.
# Primary (highest value): meta/muse-spark-1.2-contributor
# Fallbacks (approved): deepseek/deepseek-chat (deepseek flash),
#   z-ai/glm-5.3-flash (glm flash), qwen/qwen3.8-flash (qwen 3.8 flash).
# All routed as openrouter/<model> with provider=openai and
# base_url=https://openrouter.ai/api/v1 — change only NOOA_MODEL_NAME.
#
#   NOOA_MODEL_NAME=openrouter/meta/muse-spark-1.2-contributor
#                    ^ litellm routing string (openrouter/ prefix required)
#   NOOA_MODEL_BASE_URL=https://openrouter.ai/api/v1
#                    ^ endpoint surface (OpenRouter, OpenAI-compatible)
#   NOOA_API_KEY=<your OpenRouter key>
#                    ^ credential for that surface
#
# OpenRouter (OpenAI-compatible): keep provider=openai — informational.
# The model id's openrouter/ prefix + base URL routes through litellm.
#
NOOA_MODEL_PROVIDER=openai
NOOA_MODEL_NAME=openrouter/meta/muse-spark-1.2-contributor
NOOA_API_KEY=
NOOA_MODEL_BASE_URL=https://openrouter.ai/api/v1
NOOA_MODEL_TEMPERATURE=0.2
NOOA_SESSION_ID=
# Per-agent LLM call budgets (seconds). The live envelope prompts are large;
# keep these above the endpoint's real latency.
NOOA_SPECIALIST_TIMEOUT_S=120
NOOA_CONTROLLER_TIMEOUT_S=180
# ---------------------------------------------------------------------------
# Calculation control plane
# ---------------------------------------------------------------------------
# The calculation container is the ONLY process that constructs substrate
# workers. Every other caller (harness --inference, `nooa market substrate
# invoke`, the engine's substrate.* tools) requests a fire-tick over this
# plane, so the caller never collides with the live workers' consumer groups
# and supervisor keys.
#
# CALC_CONTROL_PORT   port the plane listens on inside the container, and the
#                     host loopback port it is published to.
# CALC_CONTROL_URL    how callers reach it. Containers on the compose network
#                     use the service name; a host venv uses loopback:
#                       in-compose : http://calculation:8041
#                       host venv  : http://127.0.0.1:8041
# CALC_CONTROL_TIMEOUT_S  per-request budget; a hung plane must not stall an
#                     inference round.
CALC_CONTROL_PORT=8041
CALC_CONTROL_URL=http://calculation:8041
CALC_CONTROL_TIMEOUT_S=30
