# Postgres is exposed to the host for inspection only. Do not commit a real .env file.
POSTGRES_DB=marketflow
POSTGRES_USER=marketflow
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://marketflow:change-me@postgres:5432/marketflow
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=marketflow
REDIS_STREAM_MAXLEN=10000

# Collector / orchestrator behavior
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
POLL_SECONDS=30
FLOW_WINDOW_SECONDS=300
DEPTH_LEVELS=20
MAX_DOMAIN_STATE_AGE_SECONDS=90
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# External API credentials.
# Per the containerization contract, ONLY the `data-access` service is allowed
# to read these. `calculations`, `analysis`, and `orchestrator` must NOT
# receive any of these values (docker-compose.yml does not forward them).
# Leave blank if you are running against public-only Binance endpoints.
# ---------------------------------------------------------------------------
BINANCE_BASE_URL=
CRYPTOQUANT_API_KEY=
COINGECKO_BASE_URL=
